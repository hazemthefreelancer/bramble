{% liquid
  assign product = section.settings.product
  assign image_position = section.settings.image_position
  assign image_width = section.settings.image_width
%}

{% render 'quantity-selector-styles' %}
{% render 'variant-picker-styles' %}
{% render 'buy-buttons-styles' %}

<div
  class="
    product-spotlight
    section
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --direction: {{ image_position }};
    --image-width: {{ image_width }}%;
  "
>
  <div class="product-spotlight__container">
    <div class="product-spotlight__image">
      {% content_for 'block', type: 'image', id: 'image' %}
    </div>

    <div class="product-spotlight__content">
      {% content_for 'blocks', closest.product: product %}
    </div>
  </div>
</div>

<script type="application/ld+json">
  {{ section.settings.product | structured_data }}
</script>

{% stylesheet %}
  .product-spotlight__container {
    display: flex;
    flex-direction: var(--direction);
    align-items: center;
    gap: min(4vw, 80px);

    @media screen and (max-width: 749px) {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    > * {
      flex: 1;
      width: 100%;
    }
  }

  .product-spotlight__content {
    display: flex;
    flex-direction: column;
    gap: 32px;

    @media screen and (max-width: 749px) {
      gap: 24px;
    }
  }
{% endstylesheet %}

