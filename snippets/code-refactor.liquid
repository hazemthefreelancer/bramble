{% comment %} Version A: Clickable product card {% endcomment %}
{% for product in collections.all.products %}
  <div class="product-card">
    <a class="product-card__link" href="{{ product.url }}">
      <div class="product-card__inner">
        <div class="product-card__image">
          {% if product.featured_image != blank %}
            {% assign sizes = 'auto, (min-width: 750px) 50vw, 100vw' %}
            {% assign widths = '240, 320, 375, 750, 832, 990, 1200, 1600, 1920' %}
            {{
              product.featured_image
              | image_url: width: 1920
              | image_tag: class: 'image-cover', widths: widths, sizes: sizes, loading: 'lazy'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'image-cover placeholder-svg' }}
          {% endif %}
        </div>

        <div class="product-card__content">
          <h3 class="product-card__title">{{ product.title }}</h3>

          <div class="product-card__description rte">{{ product.description }}</div>

          {% assign quantity = product.selected_or_first_available_variant.inventory_quantity %}
          {% if quantity > 0 and quantity <= 20 %}
            <span class="product-card__stock-alert">Only {{ quantity }} left — hurry!</span>
          {% endif %}
        </div>
      </div>
    </a>
  </div>
{% endfor %}

{% comment %} Version B: Buy Now button {% endcomment %}
{% for product in collections.all.products %}
  <div class="product-card">
    <div class="product-card__image">
      {% if product.featured_image != blank %}
        {% assign sizes = 'auto, (min-width: 750px) 50vw, 100vw' %}
        {% assign widths = '240, 320, 375, 750, 832, 990, 1200, 1600, 1920' %}
        {{
          product.featured_image
          | image_url: width: 1920
          | image_tag: class: 'image-cover', widths: widths, sizes: sizes, loading: 'lazy'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'image-cover placeholder-svg' }}
      {% endif %}
    </div>

    <div class="product-card__content">
      <h3 class="product-card__title">{{ product.title }}</h3>

      <div class="product-card__description rte">{{ product.description }}</div>

      {% assign quantity = product.selected_or_first_available_variant.inventory_quantity %}
      {% if quantity > 0 and quantity <= 20 %}
        <span class="product-card__stock-alert">Only {{ quantity }} left — hurry!</span>
      {% endif %}
    </div>

    {% comment %} Buy now is a bit misleading. {% endcomment %}
    <a class="product-card__link" href="{{ product.url }}">Buy Now</a>
  </div>
{% endfor %}

